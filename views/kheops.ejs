<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Kheops - Détail Interaction</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: Arial, sans-serif; font-size: 11px; background: #fff; color: #000; }

    /* Top bar */
    #topbar {
      background: #1e4d8c;
      color: white;
      padding: 3px 8px;
      font-size: 12px;
      font-weight: bold;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    /* Toolbar */
    #toolbar {
      background: #f0f0f0;
      border-bottom: 1px solid #c0c0c0;
      padding: 3px 6px;
      display: flex;
      align-items: center;
      gap: 3px;
    }
    .toolbtn {
      background: linear-gradient(to bottom, #ffffff, #e0e0e0);
      border: 1px solid #ababab;
      padding: 2px 10px;
      font-size: 11px;
      cursor: pointer;
    }
    .toolbtn:hover { background: linear-gradient(to bottom, #dce8fb, #c2d8f8); border-color: #7b9ebd; }
    .toolbtn.primary {
      background: linear-gradient(to bottom, #4a90d9, #1e6bb8);
      color: white; border-color: #1a5a9a; font-weight: bold;
    }
    .toolbtn.primary:hover { background: linear-gradient(to bottom, #5aa0e9, #2e7bc8); }
    .toolbtn:disabled { opacity: 0.5; cursor: not-allowed; }
    .toolbar-sep { width: 1px; background: #c0c0c0; height: 18px; margin: 0 4px; }

    /* Header */
    #header-fields {
      background: #fff;
      border-bottom: 1px solid #c0c0c0;
      padding: 4px 6px 4px 40px;
      display: grid;
      grid-template-columns: auto 180px 1fr auto 180px 1fr auto 180px;
      column-gap: 6px;
      row-gap: 3px;
      align-items: center;
    }
    .hdr-label { font-size: 11px; color: #333; white-space: nowrap; }
    .hdr-field {
      background: white;
      border: 1px solid #7b9ebd;
      padding: 1px 4px;
      font-size: 11px;
      height: 19px;
      width: 100%;
    }
    .hdr-field[readonly] { background: #f0f0f0; border-color: #c0c0c0; }
    select.hdr-field { padding: 0 2px; cursor: pointer; }

    /* Feedback */
    #feedback { padding: 2px 8px 0 8px; }
    .alert-success {
      background: #dff0d8; color: #3c763d;
      border: 1px solid #b2d9a8;
      padding: 3px 8px; font-size: 11px;
    }
    .alert-error {
      background: #f2dede; color: #a94442;
      border: 1px solid #e4b9b9;
      padding: 3px 8px; font-size: 11px;
    }

    /* Main layout */
    #main { display: flex; height: calc(100vh - 112px); overflow: hidden; }

    /* Sidebar */
    #sidebar {
      width: 34px;
      background: #1e4d8c;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding-top: 3px;
      gap: 2px;
      flex-shrink: 0;
    }
    .sidebar-icon {
      width: 26px; height: 26px;
      background: linear-gradient(135deg, #3a6dbc, #1e4d8c);
      border: 1px solid #4a7dcc;
      border-bottom-color: #0e3d7c;
      border-right-color: #0e3d7c;
      display: flex; align-items: center; justify-content: center;
      cursor: pointer;
    }
    .sidebar-icon:hover { background: linear-gradient(135deg, #5a8de0, #2e5dac); }
    .sidebar-icon.active { background: linear-gradient(135deg, #6aa0f0, #3a70d0); border-color: #7ab0ff; }
    .sidebar-icon svg { width: 14px; height: 14px; }

    /* Content */
    #content { flex: 1; overflow-y: auto; background: #fff; }

    /* Tabs */
    #tabs {
      display: flex;
      border-bottom: 2px solid #1e6bb8;
      background: #f0f0f0;
      padding: 3px 6px 0;
      gap: 2px;
    }
    .tab {
      padding: 3px 14px;
      border: 1px solid #c0c0c0;
      border-bottom: none;
      background: #e0e0e0;
      cursor: pointer;
      font-size: 11px;
    }
    .tab.active {
      background: white;
      border-color: #1e6bb8;
      border-bottom: 2px solid white;
      margin-bottom: -2px;
      color: #1e4d8c;
      font-weight: bold;
    }
    .tab:hover:not(.active) { background: #ebebeb; }

    /* Two equal columns */
    #tab-content {
      padding: 6px;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 6px;
      align-items: start;
    }

    /* Panels */
    .panel { border: 1px solid #c0c0c0; background: white; margin-bottom: 5px; }
    .panel-title {
      color: #1e4d8c; font-weight: bold; font-size: 11px;
      padding: 2px 6px; border-bottom: 1px solid #e0e0e0;
      background: linear-gradient(to bottom, #f8f8f8, #efefef);
    }
    .panel-body { padding: 5px 6px; }

    /* Form rows — labels tight next to inputs */
    .form-row {
      display: flex;
      align-items: center;
      margin-bottom: 3px;
      gap: 0;
    }
    .field-label {
      font-size: 11px; color: #333;
      white-space: nowrap;
      min-width: 110px;
      text-align: right;
      padding-right: 5px;
      flex-shrink: 0;
    }
    .field-label.required::after { content: ' *'; color: #cc0000; }
    .field-input {
      border: 1px solid #c0c0c0;
      background: #f8f8f8;
      height: 17px; font-size: 11px; padding: 0 3px;
      flex: 1; min-width: 0;
    }
    .field-select {
      border: 1px solid #c0c0c0; background: #f8f8f8;
      height: 19px; font-size: 11px; flex: 1; min-width: 0;
    }
    .field-textarea {
      border: 1px solid #c0c0c0; background: white;
      font-size: 11px; width: 100%; padding: 2px 3px;
      resize: vertical; min-height: 52px; margin-top: 3px;
    }

    /* Icon buttons next to inputs — style original */
    .input-group { display: flex; align-items: center; flex: 1; min-width: 0; gap: 1px; }
    .input-group input { flex: 1; min-width: 0; }
    .ibtn {
      width: 17px; height: 17px;
      border: 1px solid #7b9ebd;
      background: linear-gradient(to bottom, #e8f0fb, #ccdaf4);
      display: flex; align-items: center; justify-content: center;
      cursor: pointer; flex-shrink: 0; font-size: 9px; color: #1e4d8c;
    }
    .ibtn:hover { background: linear-gradient(to bottom, #d0e4ff, #a8c8f0); }
    .ibtn.red { border-color: #cc8888; background: linear-gradient(to bottom, #fbe8e8, #f4cccc); color: #993333; }
    .ibtn.red:hover { background: linear-gradient(to bottom, #ffd0d0, #f0a8a8); }

    .checkbox-row { display: flex; align-items: center; gap: 4px; margin: 3px 0 3px 110px; font-size: 11px; }
    .separator { height: 1px; background: #e8e8e8; margin: 4px 0; }

    /* Blue action button */
    .action-btn {
      background: linear-gradient(to bottom, #4a90d9, #1e6bb8);
      color: white; border: 1px solid #1a5a9a;
      padding: 2px 14px; font-size: 11px; cursor: pointer;
      white-space: nowrap;
    }
    .action-btn:hover { background: linear-gradient(to bottom, #5aa0e9, #2e7bc8); }

    /* Solution section */
    .sol-header { display: flex; align-items: center; border-bottom: 1px solid #c0c0c0; margin-bottom: 4px; gap: 6px; }
    .sol-tab { padding: 2px 10px; font-size: 11px; color: #1e4d8c; font-weight: bold; border-bottom: 2px solid #1e6bb8; cursor: pointer; }
    .sol-label { font-size: 11px; color: #333; white-space: nowrap; }
  </style>
</head>
<body>

  <div id="topbar">
    <svg width="14" height="14" viewBox="0 0 16 16"><rect x="1" y="1" width="14" height="14" rx="2" fill="none" stroke="white" stroke-width="1.5"/><text x="3" y="11" font-size="9" fill="white">K</text></svg>
    Kheops
  </div>

  <div id="toolbar">
    <button class="toolbtn primary" id="saveBtn" onclick="saveInteraction()">&#128190; Enregistrer</button>
    <button class="toolbtn">&#8634; Actualiser</button>
    <span class="toolbar-sep"></span>
    <button class="toolbtn">Consulter</button>
    <button class="toolbtn">Dupliquer</button>
    <button class="toolbtn">Supprimer</button>
  </div>

  <div id="header-fields">
    <span class="hdr-label">ID Interaction :</span>
    <input id="externalId" class="hdr-field" type="text" value="CALL83729178" autocomplete="off">
    <span></span>
    <span class="hdr-label">Phase :</span>
    <input class="hdr-field" type="text" value="Consignation" readonly>
    <span></span>
    <span class="hdr-label">Propriétaire :</span>
    <input class="hdr-field" type="text" value="U721412" readonly>

    <span class="hdr-label">Nature appel :</span>
    <select class="hdr-field">
      <option>Entrant</option><option>Sortant</option><option>Interne</option>
    </select>
    <span></span>
    <span class="hdr-label">Statut :</span>
    <select id="status" class="hdr-field">
      <% statusValues.forEach(function(val) { %>
        <option value="<%= val %>"><%= val %></option>
      <% }); %>
    </select>
    <span></span>
    <span class="hdr-label">Groupe ouverture :</span>
    <input class="hdr-field" type="text" value="KHEOPS" readonly>
  </div>

  <div id="feedback"></div>

  <div id="main">
    <div id="sidebar">
      <div class="sidebar-icon active">
        <svg viewBox="0 0 14 14" fill="none" stroke="white" stroke-width="1.2"><rect x="1" y="1" width="12" height="12"/><line x1="3" y1="4" x2="11" y2="4"/><line x1="3" y1="7" x2="11" y2="7"/><line x1="3" y1="10" x2="8" y2="10"/></svg>
      </div>
      <div class="sidebar-icon">
        <svg viewBox="0 0 14 14" fill="none" stroke="white" stroke-width="1.2"><circle cx="7" cy="5" r="2.5"/><path d="M1.5 13c0-3 2.5-5 5.5-5s5.5 2 5.5 5"/></svg>
      </div>
      <div class="sidebar-icon">
        <svg viewBox="0 0 14 14" fill="none" stroke="white" stroke-width="1.2"><path d="M2 1h10v12H2z"/><line x1="4" y1="4" x2="10" y2="4"/><line x1="4" y1="6.5" x2="10" y2="6.5"/><line x1="4" y1="9" x2="7" y2="9"/></svg>
      </div>
      <div class="sidebar-icon">
        <svg viewBox="0 0 14 14" fill="none" stroke="white" stroke-width="1.2"><rect x="1" y="3" width="12" height="9" rx="1"/><line x1="4" y1="3" x2="4" y2="2"/><line x1="7" y1="3" x2="7" y2="2"/><line x1="10" y1="3" x2="10" y2="2"/></svg>
      </div>
      <div class="sidebar-icon">
        <svg viewBox="0 0 14 14" fill="none" stroke="white" stroke-width="1.2"><polyline points="1,10 4,7 6.5,9.5 10,4 13,6"/></svg>
      </div>
      <div class="sidebar-icon">
        <svg viewBox="0 0 14 14" fill="none" stroke="white" stroke-width="1.2"><path d="M2 12l3-3 2 2 5-8"/></svg>
      </div>
    </div>

    <div id="content">
      <div id="tabs">
        <div class="tab active">Détail de l'interaction</div>
        <div class="tab">Historique</div>
        <div class="tab">Inventaire</div>
        <div class="tab">Pilotes en cours</div>
      </div>

      <div id="tab-content">

        <!-- COLONNE GAUCHE -->
        <div>
          <div class="panel">
            <div class="panel-title">Bénéficiaire</div>
            <div class="panel-body">
              <div class="form-row">
                <span class="field-label required">Contact / Site :</span>
                <div class="input-group">
                  <input class="field-input" type="text">
                  <span class="ibtn">&#9998;</span><span class="ibtn">&#9776;</span>
                  <input class="field-input" type="text" style="max-width:80px">
                  <span class="ibtn">&#9776;</span><span class="ibtn red">&#10007;</span>
                </div>
              </div>
              <div class="form-row">
                <span class="field-label">Nom complet :</span>
                <input class="field-input" type="text">
              </div>
              <div class="form-row">
                <span class="field-label">Hiérarchie :</span>
                <input class="field-input" type="text">
              </div>
              <div class="form-row">
                <span class="field-label">Enseigne :</span>
                <div class="input-group">
                  <input class="field-input" type="text">
                  <input class="field-input" type="text" style="max-width:60px">
                  <input class="field-input" type="text" style="max-width:60px">
                </div>
              </div>
              <div class="form-row">
                <span class="field-label">Segmentation :</span>
                <input class="field-input" type="text" style="max-width:140px">
              </div>
              <div class="form-row">
                <span class="field-label">Réseau partenaire :</span>
                <input class="field-input" type="text" style="max-width:140px">
              </div>
              <div class="form-row" style="align-items:flex-start">
                <span class="field-label" style="padding-top:1px">Flag site :</span>
                <div>
                  <div class="input-group">
                    <input class="field-input" type="text" style="max-width:130px">
                    <span class="ibtn">&#128269;</span>
                  </div>
                  <input class="field-input" type="text" style="max-width:130px;margin-top:2px">
                </div>
              </div>
            </div>
          </div>

          <div class="panel">
            <div class="panel-title">Appelant</div>
            <div class="panel-body">
              <div class="form-row">
                <span class="field-label">Code Contact :</span>
                <div class="input-group">
                  <input class="field-input" type="text">
                  <span class="ibtn">&#9998;</span><span class="ibtn">&#9776;</span>
                  <input class="field-input" type="text" style="flex:2">
                </div>
              </div>
              <div class="form-row">
                <span class="field-label">Qualificatif :</span>
                <select class="field-select" style="max-width:150px"><option></option></select>
              </div>
              <div class="checkbox-row">
                <input type="checkbox" id="transfert"><label for="transfert">Transfert direct</label>
              </div>
            </div>
          </div>

          <div class="panel">
            <div class="panel-body">
              <div class="sol-header">
                <span class="sol-tab">Solution</span>
                <span class="sol-label">Code résolution :</span>
                <div class="input-group" style="flex:1">
                  <input class="field-input" type="text">
                  <span class="ibtn">&#9998;</span>
                </div>
              </div>
              <textarea class="field-textarea" rows="4"></textarea>
            </div>
          </div>
        </div>

        <!-- COLONNE DROITE -->
        <div>
          <div class="panel">
            <div class="panel-body">
              <div class="form-row">
                <span class="field-label">Elément config. :</span>
                <div class="input-group">
                  <input class="field-input" type="text">
                  <span class="ibtn">&#9998;</span><span class="ibtn">&#9776;</span><span class="ibtn red">&#10007;</span>
                </div>
              </div>
              <div class="form-row">
                <span class="field-label">Nom modèle :</span>
                <input class="field-input" type="text">
              </div>
              <div class="separator"></div>
              <div class="form-row">
                <span class="field-label">Catégorie :</span>
                <div class="input-group">
                  <input class="field-input" type="text">
                  <span class="ibtn">&#9998;</span><span class="ibtn red">&#10007;</span>
                </div>
              </div>
              <div class="form-row">
                <span class="field-label">Sous-catégorie :</span>
                <div class="input-group">
                  <input class="field-input" type="text">
                  <span class="ibtn">&#9998;</span><span class="ibtn">&#9776;</span>
                </div>
              </div>
              <div class="form-row">
                <span class="field-label">Type de produit :</span>
                <div class="input-group">
                  <input class="field-input" type="text">
                  <span class="ibtn">&#9998;</span><span class="ibtn">&#9776;</span>
                </div>
              </div>
              <div class="form-row">
                <span class="field-label">Elément config. :</span>
                <div class="input-group">
                  <input class="field-input" type="text">
                  <span class="ibtn">&#9998;</span><span class="ibtn">&#9776;</span>
                </div>
              </div>
              <div class="separator"></div>
              <div class="form-row">
                <span class="field-label">Groupe affectation :</span>
                <select class="field-select"><option></option><option>Support N1</option><option>Support N2</option></select>
              </div>
              <div class="form-row">
                <span class="field-label">Notifier par :</span>
                <select class="field-select"><option>Aucun</option><option>Email</option><option>SMS</option></select>
              </div>
              <div class="separator"></div>
              <div style="display:flex;gap:6px;align-items:center;margin:5px 0 5px 110px">
                <button class="action-btn">Panne groupée</button>
                <input class="field-input" type="text" style="flex:1">
              </div>
              <div class="separator"></div>
              <div class="form-row" style="align-items:flex-start">
                <span class="field-label required" style="padding-top:2px">Description :</span>
                <textarea class="field-textarea" style="margin-top:0" rows="5"></textarea>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>

  <script>
    async function saveInteraction() {
      const externalId = document.getElementById('externalId').value.trim();
      const status = document.getElementById('status').value;
      const feedback = document.getElementById('feedback');
      const btn = document.getElementById('saveBtn');

      if (!externalId || !status) {
        feedback.innerHTML = '<div class="alert-error">Veuillez renseigner l\'ID Interaction et le Statut.</div>';
        return;
      }

      btn.disabled = true;
      btn.textContent = 'Enregistrement...';
      feedback.innerHTML = '';

      try {
        const response = await fetch('/update-case', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ externalId, status }),
        });

        const data = await response.json();

        if (data.success) {
          feedback.innerHTML = `<div class="alert-success">&#10004; Interaction <strong>${externalId}</strong> enregistrée — Statut mis à jour : <strong>${status}</strong></div>`;
        } else {
          feedback.innerHTML = `<div class="alert-error">&#10008; Erreur : ${data.error}</div>`;
        }
      } catch (err) {
        feedback.innerHTML = `<div class="alert-error">&#10008; Erreur réseau : ${err.message}</div>`;
      } finally {
        btn.disabled = false;
        btn.textContent = '💾 Enregistrer';
      }
    }
  </script>
</body>
</html>
