<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mise à jour de demande</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      max-width: 600px;
      margin: 60px auto;
      padding: 0 20px;
      background: #f5f5f5;
    }
    h1 {
      font-size: 1.4rem;
      color: #333;
      margin-bottom: 24px;
    }
    .card {
      background: white;
      border-radius: 8px;
      padding: 32px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }
    label {
      display: block;
      font-size: 0.85rem;
      font-weight: bold;
      color: #555;
      margin-bottom: 6px;
    }
    input, select {
      width: 100%;
      padding: 10px 12px;
      border: 1px solid #ccc;
      border-radius: 4px;
      font-size: 1rem;
      box-sizing: border-box;
      margin-bottom: 20px;
    }
    button {
      background: #0070d2;
      color: white;
      border: none;
      padding: 12px 24px;
      border-radius: 4px;
      font-size: 1rem;
      cursor: pointer;
      width: 100%;
    }
    button:hover { background: #005fb2; }
    button:disabled { background: #999; cursor: not-allowed; }
    .alert-success {
      background: #e8f5e9;
      color: #2e7d32;
      border: 1px solid #a5d6a7;
      border-radius: 4px;
      padding: 12px 16px;
      margin-bottom: 20px;
    }
    .alert-error {
      background: #ffebee;
      color: #c62828;
      border: 1px solid #ef9a9a;
      border-radius: 4px;
      padding: 12px 16px;
      margin-bottom: 20px;
    }
    #feedback { margin-bottom: 4px; }
  </style>
</head>
<body>
  <h1>Mise à jour d'une demande</h1>
  <div class="card">
    <div id="feedback"></div>

    <form id="updateForm">
      <label for="externalId">Numéro de la demande</label>
      <input
        type="text"
        id="externalId"
        name="externalId"
        placeholder="Identifiant externe de la demande"
        required
      >

      <label for="status">Statut</label>
      <select id="status" name="status" required>
        <option value="">-- Sélectionner un statut --</option>
        <% statusValues.forEach(function(val) { %>
          <option value="<%= val %>"><%= val %></option>
        <% }); %>
      </select>

      <button type="submit" id="submitBtn">Mettre à jour</button>
    </form>
  </div>

  <script>
    document.getElementById('updateForm').addEventListener('submit', async function(e) {
      e.preventDefault();
      const externalId = document.getElementById('externalId').value;
      const status = document.getElementById('status').value;
      const feedback = document.getElementById('feedback');
      const btn = document.getElementById('submitBtn');

      btn.disabled = true;
      btn.textContent = 'Mise à jour en cours...';
      feedback.innerHTML = '';

      try {
        const response = await fetch('/update-case', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ externalId, status }),
        });

        const data = await response.json();

        if (data.success) {
          feedback.innerHTML = `<div class="alert-success">La demande <strong>${externalId}</strong> a été mise à jour avec le statut <strong>${status}</strong>.</div>`;
        } else {
          feedback.innerHTML = `<div class="alert-error">Erreur : ${data.error}</div>`;
        }
      } catch (err) {
        feedback.innerHTML = `<div class="alert-error">Erreur réseau : ${err.message}</div>`;
      } finally {
        btn.disabled = false;
        btn.textContent = 'Mettre à jour';
      }
    });
  </script>
</body>
</html>
