# URL de l'instance Salesforce (ex: https://cvplatformdemo.my.salesforce.com)
SF_INSTANCE_URL=

# Client Credentials OAuth - depuis l'External Client App "KheopsApp" dans Salesforce
SF_CLIENT_ID=
SF_CLIENT_SECRET=

# Developer name du champ External ID sur l'objet Case (défaut: Kheops_External_ID__c)
SF_EXTERNAL_ID_FIELD=Kheops_External_ID__c

# Version de l'API Salesforce (défaut: v62.0)
SF_API_VERSION=v62.0
